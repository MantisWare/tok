---
source: src/mem/db.rs
expression: "rows.join(\"\\n\")"
---
[index] idx_edges_repo
CREATE INDEX idx_edges_repo   ON edges(repo_id)

[index] idx_edges_source
CREATE INDEX idx_edges_source ON edges(source_id)

[index] idx_edges_target
CREATE INDEX idx_edges_target ON edges(target_id)

[index] idx_edges_type
CREATE INDEX idx_edges_type   ON edges(edge_type)

[index] idx_episodes_repo
CREATE INDEX idx_episodes_repo   ON episodes(repo_id)

[index] idx_episodes_symbol
CREATE INDEX idx_episodes_symbol ON episodes(symbol_id)

[index] idx_episodes_time
CREATE INDEX idx_episodes_time   ON episodes(timestamp)

[index] idx_symbols_file
CREATE INDEX idx_symbols_file    ON symbols(file_path)

[index] idx_symbols_graph
CREATE INDEX idx_symbols_graph ON symbols(graph_id)

[index] idx_symbols_kind
CREATE INDEX idx_symbols_kind    ON symbols(kind)

[index] idx_symbols_name
CREATE INDEX idx_symbols_name    ON symbols(name)

[index] idx_symbols_repo
CREATE INDEX idx_symbols_repo   ON symbols(repo_id)

[table] edges
CREATE TABLE edges (
            id        INTEGER PRIMARY KEY,
            source_id TEXT NOT NULL REFERENCES symbols(id) ON DELETE CASCADE,
            target_id TEXT NOT NULL REFERENCES symbols(id) ON DELETE CASCADE,
            edge_type TEXT NOT NULL,
            repo_id   TEXT NOT NULL,
            branch    TEXT NOT NULL DEFAULT 'main'
        )

[table] episodes
CREATE TABLE episodes (
            id           TEXT PRIMARY KEY,
            repo_id      TEXT NOT NULL REFERENCES repositories(repo_id) ON DELETE CASCADE,
            symbol_id    TEXT NOT NULL,
            change_type  TEXT NOT NULL,
            commit_hash  TEXT NOT NULL DEFAULT '',
            timestamp    TEXT NOT NULL DEFAULT '',
            diff_summary TEXT NOT NULL DEFAULT '',
            branch       TEXT NOT NULL DEFAULT 'main'
        )

[table] repositories
CREATE TABLE repositories (
            repo_id   TEXT PRIMARY KEY,
            path      TEXT NOT NULL,
            branch    TEXT NOT NULL DEFAULT 'main',
            last_indexed_at TEXT NOT NULL DEFAULT '',
            last_episode_id TEXT NOT NULL DEFAULT ''
        )

[table] symbols
CREATE TABLE symbols (
            id         TEXT PRIMARY KEY,
            repo_id    TEXT NOT NULL REFERENCES repositories(repo_id) ON DELETE CASCADE,
            name       TEXT NOT NULL,
            kind       TEXT NOT NULL,
            file_path  TEXT NOT NULL,
            line_start INTEGER NOT NULL DEFAULT 0,
            line_end   INTEGER NOT NULL DEFAULT 0,
            signature  TEXT NOT NULL DEFAULT '',
            doc_comment TEXT NOT NULL DEFAULT '',
            branch     TEXT NOT NULL DEFAULT 'main',
            indexed_at TEXT NOT NULL DEFAULT '',
            graph_id   TEXT NOT NULL DEFAULT ''
        )

[table] symbols_fts
CREATE VIRTUAL TABLE symbols_fts USING fts5(
            name,
            signature,
            doc_comment,
            file_path,
            symbol_id
        )

[table] symbols_fts_config
CREATE TABLE 'symbols_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID

[table] symbols_fts_content
CREATE TABLE 'symbols_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2, c3, c4)

[table] symbols_fts_data
CREATE TABLE 'symbols_fts_data'(id INTEGER PRIMARY KEY, block BLOB)

[table] symbols_fts_docsize
CREATE TABLE 'symbols_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)

[table] symbols_fts_idx
CREATE TABLE 'symbols_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID
